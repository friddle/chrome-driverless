# Base image for chrome-driverless
# Built infrequently - contains all system deps, fonts, chromium
# 钉住 bookworm：最新 slim 已是 Debian 13(trixie)，NodeSource setup_20.x 在 trixie 上依赖冲突装不上
FROM python:3.11-slim-bookworm

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources && \
    http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= \
    apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg2 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    curl unzip locales xvfb x11-utils \
    fonts-wqy-zenhei fonts-wqy-microhei \
    && fc-cache -fv > /dev/null \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i 's/# zh_CN.UTF-8/zh_CN.UTF-8/' /etc/locale.gen && locale-gen
ENV LANG=zh_CN.UTF-8 LC_ALL=zh_CN.UTF-8 LANGUAGE=zh_CN:zh

# 钉住 bookworm：最新 slim 已是 Debian 13(trixie)，NodeSource setup_20.x 在 trixie 上依赖冲突装不上
# nodesource 下载走代理会 SSL 失败，直连（国内可达）
RUN http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY}

RUN http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= \
    pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
fastapi
uvicorn
playwright
pydantic
Pillow
websockets

# cdn.playwright.dev 经代理不可达（TLS 重置），改走 npmmirror 镜像（阿里云，国内直连实测 200）
# chromium 184MB 用 curl 手动下载解压（阿里云直连不走代理：--noproxy '*' 覆盖 build-arg 代理）
RUN mkdir -p /root/.cache/ms-playwright && \
    curl -fsSL --noproxy '*' --retry 3 --connect-timeout 20 \
      -o /tmp/chrome-linux64.zip \
      "https://cdn.npmmirror.com/binaries/playwright/builds/cft/151.0.7922.34/linux64/chrome-linux64.zip" && \
    mkdir -p /root/.cache/ms-playwright/chromium-1234 && \
    unzip -q /tmp/chrome-linux64.zip -d /root/.cache/ms-playwright/chromium-1234/ && \
    curl -fsSL --noproxy '*' --retry 3 --connect-timeout 20 \
      -o /tmp/chrome-headless-shell.zip \
      "https://cdn.npmmirror.com/binaries/playwright/builds/cft/151.0.7922.34/linux64/chrome-headless-shell-linux64.zip" && \
    mkdir -p /root/.cache/ms-playwright/chromium_headless_shell-1234 && \
    unzip -q /tmp/chrome-headless-shell.zip -d /root/.cache/ms-playwright/chromium_headless_shell-1234/ && \
    rm -f /tmp/chrome-linux64.zip /tmp/chrome-headless-shell.zip

ENV http_proxy="" https_proxy="" HTTP_PROXY="" HTTPS_PROXY=""

RUN mkdir -p /app/data
VOLUME ["/app/data"]
EXPOSE 9223
