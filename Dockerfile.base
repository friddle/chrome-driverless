# Base image for chrome-driverless
# Built infrequently - contains all system deps, fonts, chromium
# 钉住 bookworm：最新 slim 已是 Debian 13(trixie)，NodeSource setup_20.x 在 trixie 上依赖冲突装不上
FROM python:3.11-slim-bookworm

# GitHub Actions 直连官方源（无需国内镜像）
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg2 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    curl unzip locales xvfb x11-utils \
    fonts-wqy-zenhei fonts-wqy-microhei \
    && fc-cache -fv > /dev/null \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i 's/# zh_CN.UTF-8/zh_CN.UTF-8/' /etc/locale.gen && locale-gen
ENV LANG=zh_CN.UTF-8 LC_ALL=zh_CN.UTF-8 LANGUAGE=zh_CN:zh

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# pip playwright 版本钉死，与 scripts npm 的 playwright 1.62.0 浏览器 revision(chromium-1234) 对齐
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    "playwright==1.62.0" \
    pydantic \
    Pillow \
    websockets

# 官方 CDN 下载 chromium（版本由 playwright 1.62.0 决定，自动含 headless shell）
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
RUN playwright install chromium

# Real Google Chrome, coexisting with the Playwright CfT chromium:
# opt in at runtime with BROWSER_ENGINE=chrome — UA / userAgentData brands / Widevine
# are then natively self-consistent, fixing the two biggest CfT fingerprint tells
# (brands contain only "Chromium"; missing Widevine = developer-population signal).
ARG CHROME_DEB_URL=https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
RUN curl -fsSL --retry 3 -o /tmp/google-chrome.deb "${CHROME_DEB_URL}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/google-chrome.deb \
    && rm -f /tmp/google-chrome.deb \
    && google-chrome --version
# Disable all Google data exfiltration for the real Chrome (no metrics/safe-browsing/
# sync/signin noise from the container)
RUN mkdir -p /etc/opt/chrome/policies/managed && \
    echo '{"MetricsReportingEnabled":false,"SafeBrowsingEnabled":false,"SafeBrowsingProtectionLevel":0,"SyncDisabled":true,"BrowserSignin":0,"BackgroundModeEnabled":false,"DefaultBrowserSettingEnabled":false,"PasswordLeakDetectionEnabled":false,"PromotionalTabsEnabled":false}' \
    > /etc/opt/chrome/policies/managed/zz-chrome-driverless.json

RUN mkdir -p /app/data
VOLUME ["/app/data"]
EXPOSE 9223
